{
  "name": "dsh-think-fold",
  "version": "0.1.5",
  "type": "module",
  "description": "Expands the row that is running and folds it back when it settles. A running turn keeps its procedure in one height-capped window that scrolls itself; when the turn ends it merges into the built-in finished header, leaving only the final answer. 正在跑的那一行自动展开、跑完自动收起；跑着的一轮把过程收进一个限高窗口，轮结束并进官方那条「已完成」，只留最终回复。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citrusrr/dsh-think-fold.git"
  },
  "homepage": "https://github.com/Citrusrr/dsh-think-fold#readme",
  "bugs": {
    "url": "https://github.com/Citrusrr/dsh-think-fold/issues"
  },
  "author": "Citrusrr",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "think",
    "fold",
    "collapse",
    "transcript",
    "ui"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/package.mjs && node test/merge.mjs",
    "test:contract": "node test/contract.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
